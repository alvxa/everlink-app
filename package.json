{
  "name": "everlink",
  "version": "1.0.0",
  "private": true,
  "description": "EVERLINK - Connect Beyond Boundaries. A global social networking platform.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.mjs",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "db:start": "node scripts/pg.mjs start",
    "db:stop": "node scripts/pg.mjs stop",
    "db:status": "node scripts/pg.mjs status",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "turn:start": "cross-env NODE_ENV=development node scripts/turn.mjs",
    "redis:start": "node scripts/redis.mjs start",
    "redis:stop": "node scripts/redis.mjs stop",
    "redis:status": "node scripts/redis.mjs status",
    "lt:start": "node scripts/libretranslate.mjs start",
    "lt:stop": "node scripts/libretranslate.mjs stop",
    "lt:status": "node scripts/libretranslate.mjs status",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "d3-geo": "^3.1.1",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "^2.6.0",
    "tinyld": "^1.3.4",
    "topojson-client": "^3.1.0",
    "web-push": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/topojson-client": "^3.1.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "node-turn": "^0.0.6",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
