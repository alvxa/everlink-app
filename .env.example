# ---------------------------------------------------------------------------
# EVERLINK environment configuration
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
# Local portable helper (npm run db:start) uses port 5433:
#   postgresql://postgres@localhost:5433/everlink?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/everlink?schema=public"

# Public URL of the app (required in production; used in emails, metadata and
# origin checks for state-changing API requests)
APP_URL="http://localhost:3000"
PORT=3000
# Bind address for the production server. Use 0.0.0.0 in containers/VMs.
HOSTNAME="localhost"

# Session / crypto secrets (required in production, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# 32-byte hex key used to encrypt TOTP secrets at rest
ENCRYPTION_KEY="change-me-to-64-hex-characters"

# SMTP email delivery. For local development install Mailpit
# (winget install axllent.mailpit) and run it, then use host 127.0.0.1 and port 1025.
# Inbox UI: http://127.0.0.1:8025
SMTP_HOST=""
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Everlink <no-reply@everlink.example>"

# Redis (optional; enables shared rate limits, Socket.IO events and presence across processes)
REDIS_URL=""

# WebRTC ICE servers for live rooms. STUN_URLS accepts a comma-separated list.
# TURN_URLS, TURN_USERNAME and TURN_CREDENTIAL enable relay through strict NATs.
# TURN credentials are exposed to browsers by design. Use short-lived credentials.
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Optional local relay for development and single-node deployments.
# TURN_EMBEDDED starts it inside server.mjs, or run "npm run turn:start" separately.
# For coturn or hosted TURN set TURN_EMBEDDED="false" and only fill TURN_URLS above.
TURN_EMBEDDED="false"
TURN_PORT="3478"
TURN_REALM="everlink.local"
TURN_MIN_PORT="49160"
TURN_MAX_PORT="49200"
# Comma-separated bind addresses. Empty means every interface.
# TURN_LISTEN_IPS="127.0.0.1"
# Public address when the relay sits behind NAT or a cloud firewall.
# TURN_EXTERNAL_IP=""
# TURN_DEBUG="INFO"

# Shows the seeded demo account credentials on the sign-in page.
# The seed script is development only. Keep this false on public deployments.
DEMO_MODE="false"

# Web Push notifications. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@everlink.example"

# Translation provider for Language Bridge (optional).
# Without a provider the translate endpoint returns HTTP 503 instead of fake text.
# Set TRANSLATION_PROVIDER to "mymemory" (free, no key), "libretranslate" or "google".
# MyMemory has a daily free character quota and returns 429 when exhausted, and its
# Tagalog output is unreliable. The local helper (npm run lt:start) serves LibreTranslate
# at http://127.0.0.1:5000 with the Tagalog and English models.
TRANSLATION_PROVIDER=""
TRANSLATION_API_KEY=""
TRANSLATION_BASE_URL=""

# Local LibreTranslate helper only (npm run lt:start / lt:stop / lt:status)
# LT_BIN="C:\\tools\\libretranslate-venv\\Scripts\\libretranslate.exe"
# LT_PORT=5000
# LT_LOAD_ONLY="en,tl"

# Portable PostgreSQL helper only (npm run db:start / db:stop / db:status)
# Leave these commented to use the defaults below.
# PG_BIN="C:\\tools\\pgsql\\bin"
# PG_PORT=5433

# Not implemented in this build, intentionally absent:
# - OAuth provider credentials (no social sign-in routes exist)
# - S3 storage credentials (uploads are stored on local disk only)
